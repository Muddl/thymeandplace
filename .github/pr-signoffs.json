{
  "trustedAuthors": ["Muddl"],
  "roles": {
    "arch-approved": "Architect",
    "manager-approved": "Manager",
    "liveops-approved": "LiveOps",
    "devops-approved": "DevOps",
    "ux-approved": "UX Review",
    "qa-approved": "QA"
  },
  "rules": [
    {
      "id": "arch",
      "require": ["arch-approved"],
      "paths": [
        "migrations/**",
        "internal/store/**",
        "deploy/db/**",
        "deploy/Caddyfile",
        "deploy/Caddyfile.*",
        "internal/httpx/**",
        "internal/config/**",
        "internal/archtest/**",
        "cmd/*/app.go",
        "go.mod",
        "go.sum",
        "**/views/lint_test.go",
        "internal/web/middleware.go",
        "internal/web/headers_test.go",
        "internal/admin/admin.go",
        "internal/admin/security*.go"
      ]
    },
    {
      "id": "arch-or-manager-checker",
      "require": ["arch-approved", "manager-approved"],
      "paths": [
        ".github/pr-signoffs.json",
        "cmd/prcheck/**",
        "internal/prcheck/**"
      ]
    },
    {
      "id": "liveops-or-arch",
      "require": ["liveops-approved", "arch-approved"],
      "paths": [
        "deploy/**",
        "**/compose*.yaml"
      ],
      "exclude": [
        "**/Dockerfile",
        "**/Dockerfile.*",
        "deploy/Caddyfile",
        "deploy/Caddyfile.*"
      ]
    },
    {
      "id": "devops",
      "require": ["devops-approved"],
      "paths": [
        ".github/workflows/**",
        "**/Dockerfile",
        "**/Dockerfile.*"
      ]
    },
    {
      "id": "ux",
      "require": ["ux-approved"],
      "paths": [
        "**/views/**",
        "static/**"
      ]
    },
    {
      "id": "qa",
      "require": ["qa-approved"],
      "paths": [
        "e2e/**",
        "**/playwright.config.*"
      ]
    },
    {
      "id": "qa-launch",
      "require": ["qa-approved"],
      "whenLabel": "launch-scope"
    }
  ]
}
