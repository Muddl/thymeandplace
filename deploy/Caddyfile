www.thymeand.place {
	redir https://thymeand.place{uri} permanent
}

thymeand.place {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# No access log, on purpose: request URIs carry public coordinates and
	# search text (and the admin enroll ?token=), headers carry Referer and
	# Hx-Current-Url, and every line would record the client IP. Spec §14/§15
	# allow logging only the cell_id, which the app itself logs per request.
	# Caddy's own runtime/error log (stderr, on by default) is unaffected.
	# Do not add a `log` directive here.
	#
	# The app trusts exactly one proxy hop, this Caddy, and takes the client IP
	# from the rightmost X-Forwarded-For entry (web.ClientIP). With no
	# trusted_proxies configured, Caddy discards any inbound X-Forwarded-For and
	# writes its own peer address, so that entry is the real client. Setting
	# trusted_proxies (for a CDN in front) makes Caddy keep the inbound values
	# and append the CDN edge, so every visitor behind one CDN edge would share
	# a rate-limit bucket. Change web.ClientIP before putting anything in front
	# of Caddy, and pair trusted_proxies with trusted_proxies_strict: without
	# it Caddy reads X-Forwarded-For left to right and {client_ip} is the entry
	# the client controls (docs/operations.md, "Reverse proxy trust and
	# logging").
	# Route on liveness, not /readyz. Compose and deploy.sh wait on /readyz.
	# The app shows its own retry panel during DB outages.
	reverse_proxy app:8080 {
		health_uri /healthz
		health_interval 10s
		health_timeout 2s
	}
	handle_errors 502 503 504 {
		header Retry-After 30
		root * /srv
		rewrite * /maintenance.html
		file_server {
			status 503
		}
	}
}
