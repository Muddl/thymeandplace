localhost {
	tls internal
	encode zstd gzip
	# No access log, same as the production Caddyfile (see the comment there):
	# only the app logs requests, and only with cell_id.
	reverse_proxy app:8080 {
		health_uri /healthz
		health_interval 2s
		health_timeout 1s
	}
	handle_errors 502 503 504 {
		header Retry-After 30
		root * /srv
		rewrite * /maintenance.html
		file_server {
			status 503
		}
	}
}
