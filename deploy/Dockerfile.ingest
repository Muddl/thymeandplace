# syntax=docker/dockerfile:1.27@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM golang:1.26.10@sha256:3745f1aa11822297b79113f5e84ce2bffeb039734571c39855809cfe9e5d7be6 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ingest ./cmd/ingest \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/devseed ./cmd/devseed \
 && mkdir -p /out/work

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/ingest /out/devseed /app/
# /work is the ingest_work volume's mount point. Docker seeds a fresh named
# volume from the image directory it mounts over, ownership included, so a
# nonroot-owned (65532) /work makes a new volume writable by the nonroot
# ingest process. Without it the volume is created root-owned and the first
# fetch fails with "mkdir /work/<dataset>: permission denied". A volume
# created before this fix needs a one-time chown (docs/operations.md).
COPY --from=build --chown=nonroot:nonroot /out/work /work
USER nonroot
ENTRYPOINT ["/app/ingest"]
