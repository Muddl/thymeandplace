# END-TO-END TESTS ONLY. Not secret, never used in production.
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp-e2e-only
POSTGRES_DB=thymeandplace
DATABASE_URL=postgres://tp:tp-e2e-only@db:5432/thymeandplace?sslmode=disable
ADMIN_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ADMIN_RP_ID=localhost
ADMIN_ORIGIN=https://localhost
PUBLIC_BASE_URL=https://localhost
ADMIN_BACKUP_LOGIN=off
BLOB_DIR=/work/blob
DEVSEED_ALLOW=1
# Pins the public site's "today" so month-dependent e2e scenarios (e.g. a
# May-specific season check) are deterministic. Test use only; see
# cmd/server/app.go's loadConfig, which refuses it unless ADMIN_RP_ID=localhost.
# Never set in production (not in env.example).
TP_PUBLIC_TODAY=2026-05-15
