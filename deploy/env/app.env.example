# /etc/thymeandplace/app.env: the app, and the admin CLI through
# `docker compose exec app /app/admin`. Connects as tp_app, which has no DDL
# rights and can't rewrite the audit tables.
DATABASE_URL=postgres://tp_app:TP_APP_PASSWORD@db:5432/thymeandplace?sslmode=disable
# Server pool size (default 16; public requests may use three quarters of it).
# Lower it on a small VPS, e.g. 10 with under 4 GB RAM (docs/operations.md "Capacity").
# DB_MAX_CONNS=16

# openssl rand -base64 32
ADMIN_SECRET_KEY=
ADMIN_RP_ID=thymeand.place
ADMIN_ORIGIN=https://thymeand.place
PUBLIC_BASE_URL=https://thymeand.place
# ADMIN_BACKUP_LOGIN=off
