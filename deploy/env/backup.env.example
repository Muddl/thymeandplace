# /etc/thymeandplace/backup.env: the nightly backup, as tp_backup
# (pg_read_all_data: reads everything, writes nothing).
DATABASE_URL=postgres://tp_backup:TP_BACKUP_PASSWORD@db:5432/thymeandplace?sslmode=disable

# S3-compatible bucket the dumps go to.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_USE_SSL=true

# Monitoring (docs/operations.md, "Monitoring and alerts"). The backup check's
# Healthchecks.io ping URL: a SECRET (anyone holding it can flip the check).
# Unset → that ping is off.
#HEARTBEAT_BACKUP_URL=https://hc-ping.com/<uuid>

# age public keys (space-separated) every dump is encrypted to: the off-host
# recovery key and the on-host restore-test key (docs/operations.md,
# "Backup encryption"). Public keys only, never an AGE-SECRET-KEY. Left empty,
# the backup refuses to start.
#   BACKUP_AGE_RECIPIENTS=age1<recovery-public-key> age1<restore-test-public-key>
BACKUP_AGE_RECIPIENTS=
# Set to "lifecycle" only when bucket lifecycle rules expire old backups and
# this key can't delete (docs/operations.md, "Backup deletion protection").
#BACKUP_PRUNE=lifecycle
