# /etc/thymeandplace/backup.env: the nightly backup, as tp_backup
# (pg_read_all_data: reads everything, writes nothing).
DATABASE_URL=postgres://tp_backup:TP_BACKUP_PASSWORD@db:5432/thymeandplace?sslmode=disable

# S3-compatible bucket the dumps go to.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_USE_SSL=true

# Monitoring (docs/operations.md, "Monitoring and alerts"). The backup check's
# Healthchecks.io ping URL: a SECRET (anyone holding it can flip the check).
# Unset → that ping is off.
#HEARTBEAT_BACKUP_URL=https://hc-ping.com/<uuid>
