# /etc/thymeandplace/db.env: the db service only (docs/operations.md, "First deploy").
# Generate every password with `openssl rand -hex 24` (hex, since base64's / and +
# would break the DATABASE_URLs in the other files).
#
# Bootstrap superuser: used only for init and restores (restore.env).
POSTGRES_USER=tp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thymeandplace
# Read by deploy/db/initdb/20-roles.sh on a fresh volume (and by
# deploy/db/adopt-roles.sql for an existing one). Each also goes in exactly one
# other file: owner → migrate.env and ingest.env, app → app.env, backup → backup.env.
TP_OWNER_PASSWORD=change-me
TP_APP_PASSWORD=change-me
TP_BACKUP_PASSWORD=change-me
