# /etc/thymeandplace/ingest.env: the ingest tool (and devseed), as tp_owner,
# which owns the reference tables and views it creates and swaps.
DATABASE_URL=postgres://tp_owner:TP_OWNER_PASSWORD@db:5432/thymeandplace?sslmode=disable

# S3-compatible bucket for the raw and transformed datasets.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_USE_SSL=true

# ocean ingest fetches MEOW ecoregions plus a Natural Earth land mask to clip
# them to water; both have working defaults (see internal/ingest/ocean.go).
# Override only if a source moves.
# OCEAN_SOURCE_URL=
# OCEAN_LAND_URL=
# CLIMATE_SOURCE_BASE=
