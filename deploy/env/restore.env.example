# /etc/thymeandplace/restore.env: restore.sh and restore-test.sh, as the
# bootstrap superuser (POSTGRES_USER/POSTGRES_PASSWORD from db.env): a restore
# drops and recreates the database and reinstalls PostGIS.
DATABASE_URL=postgres://tp:POSTGRES_PASSWORD@db:5432/thymeandplace?sslmode=disable

# The bucket the dumps are read from.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_USE_SSL=true

# Monitoring (docs/operations.md, "Monitoring and alerts"). The restore-test
# check's Healthchecks.io ping URL: a SECRET (anyone holding it can flip the
# check). Unset → that ping is off.
#HEARTBEAT_RESTORE_TEST_URL=https://hc-ping.com/<uuid>
