package views

import "thymeandplace/static"

templ Layout(vm LayoutVM) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			<meta name="csrf-token" content={ vm.CSRF }/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ vm.Title } · Thyme &amp; Place admin</title>
			<link rel="stylesheet" href={ static.Asset("admin.css") }/>
			<script src={ static.Asset("htmx.min.js") } defer></script>
			<script src={ static.Asset("admin.js") } defer></script>
		</head>
		<body hx-headers={ csrfHeaders(vm.CSRF) }>
			<header class="admin">
				<strong>Thyme &amp; Place admin</strong>
				if vm.SignedIn {
					<nav>
						<a href="/admin">Catalog</a>
						<a href="/admin/import">Import</a>
						<a href="/admin/export">Export</a>
						<a href="/admin/history">History</a>
						<a href="/admin/security">Security</a>
					</nav>
					<form method="post" action="/admin/logout">
						<input type="hidden" name="csrf" value={ vm.CSRF }/>
						<button type="submit">Sign out</button>
					</form>
				}
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

