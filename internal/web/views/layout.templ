package views

templ Page(p PageVM) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ p.Title } · Thyme &amp; Place</title>
			<meta name="description" content={ p.Description }/>
			<link rel="icon" type="image/svg+xml" href={ Asset("favicon.svg") }/>
			if p.Theme == "" {
				<link rel="stylesheet" href={ Asset("app.css") }/>
			} else {
				<link rel="stylesheet" href={ Asset("design/tokens-" + p.Theme + ".css") }/>
				<link rel="stylesheet" href={ Asset("design/base.css") }/>
				<link rel="stylesheet" href={ Asset("design/variant-" + p.Theme + ".css") }/>
			}
			<script src={ Asset("htmx.min.js") } defer></script>
			<script src={ Asset("app.js") } defer></script>
		</head>
		<body>
			<header class="site">
				<a class="brand" href="/">Thyme &amp; Place</a>
				<p class="tag">What's in season where you live, how to buy it, and what it goes with.</p>
			</header>
			<main>
				<section class="finder">
					<label for="q">Find your town</label>
					<input
						id="q"
						name="q"
						type="search"
						autocomplete="off"
						value={ p.Query }
						placeholder="Start typing a town or city"
						hx-get="/places"
						hx-trigger="keyup changed delay:250ms, search"
						hx-target="#places"
					/>
					<button type="button" data-geolocate>Use my location</button>
					<p id="geo-hint" class="hint" hidden>{ CopyGeoOff }</p>
					<div id="places" aria-live="polite">
						if p.Places != nil {
							@p.Places
						}
					</div>
				</section>
				<section id="results" aria-live="polite">
					if p.Results != nil {
						@p.Results
					}
				</section>
			</main>
			<footer class="site">
				<a href="/about/data">About the data</a>
				<span>Place names © GeoNames, CC BY 4.0</span>
				if p.Theme == "a" || p.Theme == "c" {
					<span>Plate: A. W. Livingston's Sons, 1897 (public domain; USDA National Agricultural Library, via Biodiversity Heritage Library)</span>
				}
			</footer>
		</body>
	</html>
}
