package views

templ PlaceList(items []PlaceItem) {
	<ul class="places" data-announce={ AnnouncePlaces(len(items)) }>
		for _, it := range items {
			<li>
				<a href={ templ.URL(it.URL) } hx-get={ it.URL } hx-target="#results" hx-push-url="true">{ it.Label }</a>
			</li>
		}
	</ul>
}

templ PlacesNoMatch(q string) {
	<p class="hint" data-announce={ AnnounceNoMatch(q) }>No places match '{ q }'. { CopyNoMatchSuffix }</p>
}

templ PlacesPaused() {
	<p class="hint" data-announce={ CopyPaused }>{ CopyPaused }</p>
}

templ PlacesKeepTyping() {
	<p class="hint" data-announce={ CopyKeepTyping }>{ CopyKeepTyping }</p>
}

templ PlacesUnavailable() {
	<p class="hint" data-announce={ CopySearchUnavailable }>{ CopySearchUnavailable }</p>
}
