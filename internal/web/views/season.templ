package views

templ Location(label string) {
	<header class="where"><h2>{ label }</h2></header>
}

templ Unsupported(seafood bool) {
	<div class="panel">
		if seafood {
			<p>{ CopyUnsupported }</p>
		} else {
			<p>{ CopyUnsupportedLand }</p>
		}
		<p><a href="/#q">{ CopySearchAnother }</a></p>
	</div>
}

templ LoadError(label, retryURL string) {
	if label != "" {
		@Location(label)
	}
	<div class="panel warn" role="alert">
		<p>{ CopyLoadError }</p>
		<p><a href={ templ.URL(retryURL) } hx-get={ retryURL } hx-target="#results">{ CopyTryAgain }</a></p>
	</div>
}

templ NotFound() {
	<div class="panel">
		<p>{ CopyNotFound }</p>
		<p><a href="/">Back to the start</a></p>
	</div>
}

templ TooMany() {
	<div class="panel"><p>{ CopyPaused }</p></div>
}

templ Season(vm SeasonVM) {
	<article class="season">
		<header class="where">
			<h2>{ vm.Label }</h2>
			<p class="when">{ vm.MonthName } · <a href="/about/data#estimates">Estimates from local climate: how we estimate</a></p>
		</header>
		if vm.Harsh {
			<p class="notice">{ CopyHarsh }</p>
		}
		for _, g := range vm.Groups {
			<section class="group">
				<h3>{ g.Title }</h3>
				<ul class="items">
					for _, it := range g.Items {
						<li class={ "item", it.StatusClass }>
							<a href={ templ.URL(it.URL) } hx-get={ it.URL } hx-target="#results" hx-push-url="true">{ it.Name }</a>
							<span class="basis">{ it.Basis }</span>
							if it.Estimate {
								<span class="badge">Estimate</span>
							}
						</li>
					}
				</ul>
			</section>
		}
	</article>
}
